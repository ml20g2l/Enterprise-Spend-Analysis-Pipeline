# Create airflow/.env with scripts/setup_airflow_env.ps1. Never commit .env.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_generated_secret
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_JWT_SECRET=replace_with_generated_secret
AIRFLOW_METADATA_PASSWORD=replace_with_generated_secret

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=enterprise_spend
MYSQL_USER=spend_app
MYSQL_PASSWORD=replace_with_local_mysql_password
