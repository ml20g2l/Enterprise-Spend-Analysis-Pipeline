__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-dbt/
.env
airflow/.env
airflow/logs/
reports/airflow/runs/

# dbt runtime artefacts are reproducible and may contain local paths.
dbt/logs/
dbt/target/
dbt/dbt_packages/
dbt/.user.yml
dbt_packages/
.DS_Store

# Local source-drop duplicates. The controlled copies live in data/raw/defra/.
/*.csv

# Deterministic generated data. Keep only the explanatory READMEs in Git.
data/raw/synthetic/*
!data/raw/synthetic/README.md
data/processed/*
!data/processed/README.md
data/quarantine/*
!data/quarantine/README.md

# Generated command logs; concise verification reports remain versioned.
reports/dbt_*.log

# Design-only prototypes and temporary Power BI export files.
powerbi/prototype/
powerbi/*.pdf
powerbi/*.png
powerbi/~$*
